    function snapshot_creation_dataset_entry($uid, $data) {
        global $plugin;
        global $rc_script;
        global $backup_cfg;

        $is_saved = !empty($data);
        $dataset_name = !empty($data['dataset']) ? htmlspecialchars($data['dataset']) : _('(Select Dataset)');
        $is_recursive = ($data['recursive'] ?? '') === 'yes';
        $autosnap = ($data['autosnap'] ?? 'no') === 'yes';
        $autoprune = ($data['autoprune'] ?? 'no') === 'yes';
        $is_active = $autosnap || $autoprune;

        if (!$is_saved) {
            $status_dot_class = "orange-text";
            $status_text = _("New Task");
        } else if (!$is_active) {
            $status_dot_class = "grey-text";
            $status_text = _("Inactive");
        } else {
            $status_dot_class = "green-text";
            $status_text = _("Active");
        }

        $ret_parts = [];
        if (!empty($data['hourly'])) $ret_parts[] = $data['hourly'].'h';
        if (!empty($data['daily'])) $ret_parts[] = $data['daily'].'d';
        if (!empty($data['weekly'])) $ret_parts[] = $data['weekly'].'w';
        if (!empty($data['monthly'])) $ret_parts[] = $data['monthly'].'m';
        if (!empty($data['yearly'])) $ret_parts[] = $data['yearly'].'y';
        $retention_summary = !empty($ret_parts) ? implode(', ', $ret_parts) : _('None');

        $trigger_uid = $data['trigger'] ?? 'no';
        $trigger_label = '';
        if ($trigger_uid !== 'no' && isset($backup_cfg[$trigger_uid])) {
            $b = $backup_cfg[$trigger_uid];
            $b_dest = (($b['type'] ?? '') === 'local') ? 'localhost' : ($b['destination_host'] ?? '');
            $trigger_label = htmlspecialchars(($b['source_dataset'] ?? '') . ' -> ' . $b_dest);
        }
