<script>
    function format_schedule_time(h, m) {
        var hour = parseInt(h, 10);
        var min = parseInt(m, 10);
        if (isNaN(hour)) hour = 0;
        if (isNaN(min)) min = 0;
        var period = hour >= 12 ? 'PM' : 'AM';
        var h12 = hour % 12;
        if (h12 === 0) h12 = 12;
        var str_h = (h12 < 10 ? '0' : '') + h12;
        var str_m = (min < 10 ? '0' : '') + min;
        return str_h + ':' + str_m + ' ' + period;
    }

    function update_schedule_summary(form) {
        var hourly = parseInt(form.find("input[name='hourly']").val() || '0', 10);
        var daily = parseInt(form.find("input[name='daily']").val() || '0', 10);
        var weekly = parseInt(form.find("input[name='weekly']").val() || '0', 10);
        var monthly = parseInt(form.find("input[name='monthly']").val() || '0', 10);
        var yearly = parseInt(form.find("input[name='yearly']").val() || '0', 10);

        var hSelect = form.find("select[name='daily_hour']");
        var mSelect = form.find("select[name='daily_min']");
        var hVal = hSelect.val() || '0';
        var mVal = mSelect.val() || '0';
        var timeStr = format_schedule_time(hVal, mVal);

        var hasScheduled = (daily > 0 || weekly > 0 || monthly > 0 || yearly > 0);
        var isHourlyOnly = (hourly > 0 && !hasScheduled);

        if (isHourlyOnly) {
            hSelect.css('opacity', '0.5');
            mSelect.css('opacity', '0.5');
        } else {
            hSelect.css('opacity', '1.0');
            mSelect.css('opacity', '1.0');
        }

        var pre = (form.find("input[name='pre_snapshot_script']").val() || '').trim();
        var post = (form.find("input[name='post_snapshot_script']").val() || '').trim();
        var hasHooks = pre !== '' || post !== '';
        var hookScope = form.find("select[name='hook_scope']").val() || 'daily';

        var schedText = '';
        if (isHourlyOnly) {
            schedText = "Takes snapshots every hour on the hour (:00). (Scheduled time only applies when daily, weekly, or monthly retention is enabled).";
        } else if (hourly > 0 && daily > 0) {
            var extraSched = weekly > 0 ? " (weekly snapshots on Mondays at " + timeStr + ")" : "";
            schedText = "Takes hourly snapshots every hour on the hour (:00), plus a daily snapshot at " + timeStr + extraSched + ".";
        } else if (hourly > 0 && weekly > 0) {
            schedText = "Takes hourly snapshots every hour on the hour (:00), plus a weekly snapshot every Monday at " + timeStr + ".";
        } else if (daily > 0) {
            var extraSched = weekly > 0 ? " (weekly snapshots on Mondays at " + timeStr + ")" : "";
            schedText = "Daily snapshot will be taken every night at " + timeStr + extraSched + ".";
        } else if (weekly > 0) {
            schedText = "Weekly snapshot will be taken every Monday at " + timeStr + ".";
        } else if (monthly > 0) {
            schedText = "Monthly snapshot will be taken on the 1st of each month at " + timeStr + ".";
        } else if (yearly > 0) {
            schedText = "Yearly snapshot will be taken on Jan 1st at " + timeStr + ".";
        } else {
            schedText = "No snapshot retention configured.";
        }

        var hookText = '';
        if (hasHooks) {
            if (hookScope === 'daily') {
                if (hourly > 0) {
                    hookText = " Hooks will only run during the " + timeStr + " scheduled snapshot.";
                } else if (hasScheduled) {
                    hookText = " Pre/post hooks will run once per scheduled cycle at " + timeStr + ".";
                } else {
                    hookText = " Hooks will run during the scheduled snapshot at " + timeStr + ".";
                }
            } else {
                if (hourly > 0) {
                    hookText = " Hooks will run on all snapshot intervals (Warning: runs every hour).";
                } else {
                    hookText = " Pre/post hooks will run on all snapshot intervals.";
                }
            }
        }

        form.find('.buddybackup-schedule-summary').text(schedText + hookText);
    }

    function snapshot_input_changed() {
        var form = $(this).closest('form.buddybackup-snapshot-dataset');
        update_schedule_summary(form);
        if (!form.find("select[name='dataset']").val()) {
            return;
        }
        form.find("input[name='#apply']").not('.lock').prop('disabled', false);
    }
    $(function() { 
        $('form.buddybackup-snapshot-dataset').each(function(){
            var f = $(this);
            f.find('select,input[type=text],input[type=number],input[type=password],input[type=checkbox],input[type=radio],input[type=file],textarea')
                .not('.lock').each(function(){$(this).on('input change', snapshot_input_changed)});
            update_schedule_summary(f);
        });
    })

    function add_dataset_for_snapshot_creation() {
        var template = $("#buddybackup-snapshot-creation-dataset-template");
        var list = $("#buddybackup-snapshot-creation-list");
        var new_uid = uid();
        var new_entry = $(template.html());
        new_entry.attr("id", "entry-" + new_uid);
        new_entry.addClass("is-expanded");
        new_entry.find(".buddybackup-header-chevron").removeClass("fa-chevron-right").addClass("fa-chevron-down");
        var new_form = new_entry.find("form.buddybackup-snapshot-dataset");
        new_form.attr("method", "POST").attr("action", "/update.php").attr("target", "progressFrame");
        new_form.find("input[name='#section']").val(new_uid);

        new_form.find('select,input[type=text],input[type=number],input[type=password],input[type=checkbox],input[type=radio],input[type=file],textarea')
            .not('.lock').each(function(){$(this).on('input change', snapshot_input_changed)});
        update_schedule_summary(new_form);

        list.append(new_entry);
    }
    function remove_dataset_from_snapshot_creation(btn) {
        swal({title:"_(Proceed)_?", text:"Remove snapshot task", type:'warning', html:true, showCancelButton:true, confirmButtonText:"_(Proceed)_", cancelButtonText:"_(Cancel)_"}, function(p){if (p) {
            var card = $(btn).closest(".buddybackup-entry-card");
            var form = card.find("form.buddybackup-snapshot-dataset");
            var the_uid = form.find("input[name='#section']").val();
            var saved = form.find("input[name='#saved']").val();
            if (saved != "true") {
                card.remove();
                return;
            }
            $.post(api_url,{cmd:'remove_sanoid_section', 'section':the_uid},function(data) {
                if (data == '') {
                    card.remove();
                } else {
                    alert(data);
                }
            });
        }});
    }
    function verify_and_submit_snapshot(btn) {
        var form = $(btn).closest('form.buddybackup-snapshot-dataset');
        var pre = (form.find("input[name='pre_snapshot_script']").val() || '').trim();
        var post = (form.find("input[name='post_snapshot_script']").val() || '').trim();
        if (pre && /^\.?[a-zA-Z0-9_\-]+\.sh$/.test(pre)) {
            swal({title:"_(Invalid hook path)_", text:"Script files must be an absolute path starting with /", type:'warning'});
            return;
        }
        if (post && /^\.?[a-zA-Z0-9_\-]+\.sh$/.test(post)) {
            swal({title:"_(Invalid hook path)_", text:"Script files must be specified with an absolute path starting with /", type:'warning'});
            return;
        }
        form.submit();
    }
</script>
