<script>
    function snapshot_input_changed() {
        var form = $(this).closest('form.buddybackup-snapshot-dataset');
        if (!form.find("select[name='dataset']").val()) {
            return;
        }
        form.find("input[name='#apply']").not('.lock').prop('disabled', false);
    }
    $(function() { 
        $('form.buddybackup-snapshot-dataset')
            .find('select,input[type=text],input[type=number],input[type=password],input[type=checkbox],input[type=radio],input[type=file],textarea')
            .not('.lock').each(function(){$(this).on('input change', snapshot_input_changed)});
    })

    function add_dataset_for_snapshot_creation() {
        var template = $("#buddybackup-snapshot-creation-dataset-template");
        var list = $("#buddybackup-snapshot-creation-list");
        var new_uid = uid();
        var new_entry = $(template.html());
        new_entry.attr("id", "entry-" + new_uid);
        new_entry.addClass("is-expanded");
        new_entry.find(".buddybackup-header-chevron").removeClass("fa-chevron-right").addClass("fa-chevron-down");
        var new_form = new_entry.find("form.buddybackup-snapshot-dataset");
        new_form.attr("method", "POST").attr("action", "/update.php").attr("target", "progressFrame");
        new_form.find("input[name='#section']").val(new_uid);

        new_form.find('select,input[type=text],input[type=number],input[type=password],input[type=checkbox],input[type=radio],input[type=file],textarea')
            .not('.lock').each(function(){$(this).on('input change', snapshot_input_changed)});

        list.append(new_entry);
    }
    function remove_dataset_from_snapshot_creation(btn) {
        swal({title:"_(Proceed)_?", text:"Remove snapshot task", type:'warning', html:true, showCancelButton:true, confirmButtonText:"_(Proceed)_", cancelButtonText:"_(Cancel)_"}, function(p){if (p) {
            var card = $(btn).closest(".buddybackup-entry-card");
            var form = card.find("form.buddybackup-snapshot-dataset");
            var the_uid = form.find("input[name='#section']").val();
            var saved = form.find("input[name='#saved']").val();
            if (saved != "true") {
                card.remove();
                return;
            }
            $.post(api_url,{cmd:'remove_sanoid_section', 'section':the_uid},function(data) {
                if (data == '') {
                    card.remove();
                } else {
                    alert(data);
                }
            });
        }});
    }
</script>
<p class="page-desc" style="margin-bottom: 12px;">
_(Set up automatic snapshot creation and pruning on your datasets. Snapshots are what gets synced to your buddy.)_
</p>

<div class="buddybackup-section-toolbar">
    <div>
        <input type="button" value="<?=_('Add Snapshot Task')?>" onclick="add_dataset_for_snapshot_creation()">
    </div>
    <div>
        <button type="button" class="alt" onclick="buddybackup_toggle_all('buddybackup-snapshot-creation-list', this)">
            <i class="fa fa-compress"></i> <span><?=_('Collapse All')?></span>
        </button>
    </div>
</div>

