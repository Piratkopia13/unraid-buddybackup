<script>
    var bb_setup_script_content = <?=json_encode($setup_script_content)?>;
    var bb_setup_script_url = <?=json_encode($setup_script_url)?>;

    function escape_html(value) {
        return String(value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }
    function shell_quote(value) {
        return "'" + String(value).replace(/'/g, "'\\''") + "'";
    }
    function copy_text(btn, text) {
        var done = function() {
            var old = $(btn).val();
            $(btn).val("Copied!").prop('disabled', true);
            window.setTimeout(function() { $(btn).val(old).prop('disabled', false); }, 1500);
        };
        if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(text).then(done, function() { fallback_copy(text); done(); });
        } else {
            fallback_copy(text);
            done();
        }
    }
    function fallback_copy(text) {
        var ta = $("<textarea>").css({position:'fixed', opacity:0}).val(text).appendTo('body');
        ta[0].select();
        document.execCommand('copy');
        ta.remove();
    }

    function generic_hosts_update() {
        var direction = $('select[name="bb-direction"]').val();
        var platform = $('select[name="bb-platform"]').val();
        var user = $('input[name="bb-user"]').val() || 'buddybackup';
        var dataset = $('input[name="bb-dataset"]').val() || 'tank/backups/unraid';
        var port = $('input[name="bb-port"]').val() || '22';

        if (direction === 'unraid_pushes') {
            $('#bb-generic-hosts-push-to-remote').show();
            $('#bb-generic-hosts-push-to-unraid').hide();
            $('.bb-generic-hosts-instructions').hide();
            $('#bb-generic-hosts-instructions-'+(platform == 'scale' ? 'scale' : 'generic')).show();

            var setup_cmd = 'curl -fsSL '+bb_setup_script_url+' | bash -s --';
            setup_cmd += ' --dataset '+shell_quote(dataset);
            setup_cmd += ' --user '+shell_quote(user);
            setup_cmd += ' --port '+shell_quote(port);
            setup_cmd += ' --pubkey '+shell_quote('<?=$public_ssh_key;?>');
            $('#bb-generic-hosts-cmd').text(setup_cmd);
        } else {
            $('#bb-generic-hosts-push-to-remote').hide();
            $('#bb-generic-hosts-push-to-unraid').show();
        }
    }
    $(function() {
        $('select[name="bb-direction"], select[name="bb-platform"], input[name="bb-user"], input[name="bb-dataset"], input[name="bb-port"]').each(function(){
            $(this).on('input change', generic_hosts_update);
        });
        generic_hosts_update();
    })
</script>
