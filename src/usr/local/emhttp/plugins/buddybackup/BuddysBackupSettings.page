<script>
function update_buddy_example(el) {
  if (!el) return;
  var form = $(el).closest('form.buddybackup-incoming-entry');
  var val = form.find('select[name=destination_dataset]').val();
  var example_text = val ? ("_(Example for what buddy can use as destination dataset:)_ " + val + "/my-stuff") : "";
  form.find('.buddybackup-destination-example').text(example_text);
}

function is_dataset_overlapping(dsA, dsB) {
  if (!dsA || !dsB) return false;
  dsA = dsA.replace(/^\/+|\/+$/g, '');
  dsB = dsB.replace(/^\/+|\/+$/g, '');
  return dsA === dsB || dsA.startsWith(dsB + '/') || dsB.startsWith(dsA + '/');
}

function buddy_input_changed(el, on_change) {
  var form = $(el).closest('form.buddybackup-incoming-entry');
  if (on_change) {
    form.find("input[name='#apply']").not('.lock').prop('disabled', false);
  }
  update_buddy_example(form.find('select[name=destination_dataset]')[0]);
}

$(function() {
  $('form.buddybackup-incoming-entry').each(function() {
    var form = $(this);
    form.find('select,input[type=text],input[type=number],textarea').not('.lock').on('input change', function() {
      buddy_input_changed(this, true);
    });
    update_buddy_example(form.find('select[name=destination_dataset]')[0]);
  });
});

function add_buddy() {
  var template = $("#buddybackup-buddy-entry-template");
  var list = $("#buddybackup-buddy-list");
  var new_uid = uid();
  var new_entry = $(template.html());
  new_entry.attr("id", "entry-" + new_uid);
  new_entry.addClass("is-expanded");
  new_entry.find(".buddybackup-header-chevron").removeClass("fa-chevron-right").addClass("fa-chevron-down");
  var new_form = new_entry.find("form.buddybackup-incoming-entry");
  new_form.attr("method", "POST").attr("action", "/update.php").attr("target", "progressFrame");
  new_form.find("input[name='#section']").val(new_uid);

  new_form.find('select,input[type=text],input[type=number],textarea').not('.lock').on('input change', function() {
    buddy_input_changed(this, true);
  });

  new_form.find("input[name='#apply']").not('.lock').prop('disabled', false);
  update_buddy_example(new_form.find('select[name=destination_dataset]')[0]);

  list.append(new_entry);
}

function remove_buddy(btn) {
  swal({title:"_(Proceed?)_", text:"_(Remove this buddy entry?)_", type:'warning', html:true, showCancelButton:true, confirmButtonText:"_(Proceed)_", cancelButtonText:"_(Cancel)_"}, function(p){
    if (p) {
      var card = $(btn).closest(".buddybackup-entry-card");
      var form = card.find("form.buddybackup-incoming-entry");
      var the_uid = form.find("input[name='#section']").val();
      var saved = form.find("input[name='#saved']").val();
      if (saved != "true") {
        card.remove();
        return;
      }
      $.post(api_url, {cmd: 'remove_incoming_section', 'section': the_uid}, function(data) {
        if (data == '') {
          card.remove();
        } else {
          alert(data);
        }
      });
    }
  });
}

function verify_and_submit_buddy(btn) {
  var form = $(btn).closest("form.buddybackup-incoming-entry");
  var current_uid = form.find("input[name='#section']").val();
  var name = (form.find("input[name='name']").val() || '').trim();
  var enabled = form.find("select[name='enable']").val() === 'yes';
  var destination_dataset = (form.find("select[name='destination_dataset']").val() || '').trim();
  var ssh_key = (form.find("input[name='ssh_key']").val() || '').trim();

  if (name === '') {
    swal({title:"_(Missing Name)_", text:"_(Please enter a name for this buddy.)_", type:'warning', html:true, confirmButtonText:"_(Ok)_"});
    return;
  }

  if (enabled) {
    if (destination_dataset === '') {
      swal({title:"_(Missing Destination)_", text:"_(Please select a destination parent dataset for this buddy.)_", type:'warning', html:true, confirmButtonText:"_(Ok)_"});
      return;
    }
    if (ssh_key === '') {
      swal({title:"_(Missing SSH Key)_", text:"_(Please enter your buddy's SSH public key.)_", type:'warning', html:true, confirmButtonText:"_(Ok)_"});
      return;
    }

    // Check for overlapping datasets across other buddy cards
    var overlap_found = false;
    var overlapping_name = '';
    var overlapping_ds = '';

    $("#buddybackup-buddy-list .buddybackup-entry-card").each(function() {
      var other_card = $(this);
      var other_form = other_card.find("form.buddybackup-incoming-entry");
      var other_uid = other_form.find("input[name='#section']").val();
      if (other_uid === current_uid) return;

      var other_ds = (other_form.find("select[name='destination_dataset']").val() || '').trim();
      var other_enabled = other_form.find("select[name='enable']").val() === 'yes';
      if (!other_enabled || other_ds === '') return;

      if (is_dataset_overlapping(destination_dataset, other_ds)) {
        overlap_found = true;
        overlapping_name = (other_form.find("input[name='name']").val() || 'Another buddy').trim();
        overlapping_ds = other_ds;
        return false;
      }
    });

    if (overlap_found) {
      swal({
        title:"_(Dataset Conflict)_",
        text:"_(Destination dataset overlaps with)_ <strong>" + overlapping_name + "</strong> (" + overlapping_ds + ").<br><br>_(Each buddy must have an independent, non-overlapping dataset for security isolation.)_",
        type:'error',
        html:true,
        confirmButtonText:"_(Ok)_"
      });
      return;
    }
  }

  form.submit();
}
</script>

