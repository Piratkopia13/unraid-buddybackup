    function backup_entry($uid, $data) {
        global $cfg;
        global $plugin;
        global $rc_script;
        global $disabled;
        global $snapshot_cfg;

        $telemetry = bb_task_telemetry($uid);
        $is_saved = !empty($data);
        $is_enabled = ($data['enable'] ?? '') === 'yes';
        $cron_value = $data['backup_cron'] ?? ($is_saved ? '' : '0 0 * * *');
        $has_cron = !empty(trim($cron_value));
        $cron = htmlspecialchars($cron_value);

        $triggering_snapshots = [];
        if (!empty($snapshot_cfg) && is_array($snapshot_cfg)) {
            foreach ($snapshot_cfg as $snap_uid => $snap) {
                if (($snap['trigger'] ?? '') === $uid) {
                    $triggering_snapshots[] = $snap['dataset'] ?? _('snapshot');
                }
            }
        }
        $is_triggered = !empty($triggering_snapshots);

        $source = !empty($data['source_dataset']) ? htmlspecialchars($data['source_dataset']) : _('(New task)');
        $type = $data['type'] ?? 'remote';
        if ($type == 'local') {
            $dest = 'local:' . htmlspecialchars($data['destination_dataset'] ?? '');
        } else {
            $dest = htmlspecialchars($data['destination_host'] ?? '') . ':' . htmlspecialchars($data['destination_dataset'] ?? '');
        }

        if (!$is_saved) {
            $status_dot_class = "orange-text";
            $status_text = _("New Task");
        } else if (!$is_enabled && !$is_triggered) {
            $status_dot_class = "grey-text";
            $status_text = _("Disabled");
        } else if ($telemetry["last_status"] === "failed") {
            $status_dot_class = "red-text";
            $status_text = _("Failed");
        } else if (!$is_enabled && $is_triggered) {
            $status_dot_class = $telemetry["status_class"];
            $status_text = ($telemetry["status_label"] == "Healthy") ? _("Triggered by snapshot") : _($telemetry["status_label"]) . " " . _("(Triggered)");
        } else if ($is_enabled && $is_triggered) {
            $status_dot_class = $telemetry["status_class"];
            $status_text = ($telemetry["status_label"] == "Healthy") ? _("Enabled + Triggered") : _($telemetry["status_label"]) . " " . _("(Cron + Trigger)");
        } else {
            $status_dot_class = $telemetry["status_class"];
            $status_text = ($telemetry["status_label"] == "Healthy") ? _("Enabled") : _($telemetry["status_label"]);
        }
        ?>
        <div class="buddybackup-entry-card <?= (!$is_saved) ? 'is-expanded' : '' ?>" id="entry-<?=$uid?>">
            <div class="buddybackup-entry-header" onclick="buddybackup_toggle_card(this)">
                <div class="buddybackup-header-left">
                    <i class="fa fa-chevron-<?= (!$is_saved) ? 'down' : 'right' ?> buddybackup-header-chevron"></i>
                    <span class="<?=$status_dot_class?>"><i class="fa fa-circle buddybackup-status-dot"></i><?=$status_text?></span>
                    <span class="buddybackup-header-route">
                        <span><?=$source?></span>
                        <span class="route-arrow"><i class="fa fa-arrow-right"></i></span>
                        <span class="route-dest"><?=$dest?></span>
                    </span>
                    <? if ($is_saved): ?>
                    <span class="buddybackup-header-telemetry">
                        <span class="metric-item <?=$telemetry['last_ran_class']?>" title="_(Last run)_">
                            <i class="fa fa-clock-o"></i> <?=$telemetry['last_ran']?>
                        </span>
                        <? if ($telemetry['dest_size'] != '-'): ?>
                        <span class="metric-item grey-text" title="_(Destination size)_">
                            <i class="fa fa-database"></i> <?=$telemetry['dest_size']?>
                        </span>
                        <? endif; ?>
                        <? if ($has_cron): ?>
                        <span class="metric-item grey-text" title="_(Cron schedule)_">
                            <i class="fa fa-calendar-o"></i> (<?=$cron?>)
                        </span>
                        <? endif; ?>
                        <? if ($is_triggered): ?>
                        <span class="metric-item grey-text" title="<?=_('Triggered after snapshot of: ') . htmlspecialchars(implode(', ', $triggering_snapshots))?>">
                            <i class="fa fa-bolt"></i> <?=_('Snapshot trigger')?>
                        </span>
                        <? endif; ?>
                    </span>
                    <? endif; ?>
                </div>
                <div class="buddybackup-header-right" onclick="event.stopPropagation()">
                    <? if ($is_saved): ?>
                    <input class="disable-on-unsaved" data-uid="<?=$uid?>" type="button" value="<?=_('Send backup now')?>" onclick="send_backup(this)" <?=$disabled?>>
                    <? endif; ?>
