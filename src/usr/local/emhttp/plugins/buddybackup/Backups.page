<script>
    var bb_setup_script_url = <?=json_encode($setup_script_url)?>;
    var bb_public_ssh_key = <?=json_encode($public_ssh_key)?>;

    function shell_single_quote(value) {
        return "'" + String(value).replace(/'/g, "'\\''") + "'";
    }
    function update_generic_setup_helper(form) {
        var user = form.find('input[name="destination_user"]').val() || 'buddybackup';
        var port = form.find('input[name="destination_port"]').val() || '22';
        var fullDataset = (form.find('input[name="destination_dataset"]').val() || '').trim();
        var parentDataset = 'tank/backups/unraid';
        if (fullDataset) {
            var lastSlash = fullDataset.lastIndexOf('/');
            if (lastSlash > 0) {
                parentDataset = fullDataset.substring(0, lastSlash);
            } else {
                parentDataset = fullDataset;
            }
        }
        var cmd = 'curl -fsSL ' + bb_setup_script_url + ' | bash -s --';
        cmd += ' --dataset ' + shell_single_quote(parentDataset);
        cmd += ' --user ' + shell_single_quote(user);
        cmd += ' --port ' + shell_single_quote(port);
        cmd += ' --pubkey ' + shell_single_quote(bb_public_ssh_key);
        form.find('.buddybackup-generic-cmd-input').val(cmd);
    }
    function shell_escape_arg(value) {
        return String(value).replace(/(["\\$`])/g, '\\$1');
    }
    function escape_html(value) {
        return String(value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }
    function start_backup_command(cmd, initial_message) {
        var output = $(".buddybackup-backup-output-log");
        $.post('/webGui/include/StartCommand.php',{cmd:cmd,start:2})
            .done(function(pid) {
                if (!isNumeric(pid)) {
                    output.append("Failed to start backup script: "+pid);
                    return;
                }
                var abort_func = function() {
                    $.post('/webGui/include/StartCommand.php', {kill: pid}, function() {
                        output.append("\nBackup aborted!\n");
                    });
                };
                output.append(initial_message);
                show_in_progress_log('Backup in progress', '#buddybackup-backup-log', 'active-textarea', "Abort backup", abort_func);
            })
            .fail(function(xhr, status, error) {
                output.append("Failed! Error: "+error);
            });
    }
    function get_backup_form(target) {
        var $el = $(target);
        if ($el.is("form.buddybackup-backup-entry")) {
            return $el;
        }
        var form = $el.closest("form.buddybackup-backup-entry");
        if (form.length) {
            return form;
        }
        form = $el.closest(".buddybackup-entry-card").find("form.buddybackup-backup-entry");
        if (form.length) {
            return form;
        }
        var cardUid = $el.data('uid') || $el.closest("[id^='entry-']").attr("id");
        if (cardUid) {
            var entryId = String(cardUid).startsWith("entry-") ? cardUid : "entry-" + cardUid;
            form = $("#" + entryId).find("form.buddybackup-backup-entry");
            if (form.length) {
                return form;
            }
        }
        return $el.closest(".buddybackup-card").find("form.buddybackup-backup-entry");
    }
    function start_saved_backup(form, command_name, initial_message) {
        var the_uid = form.find("input[name='#section']").val();
        if (!the_uid) {
            show_send_backup_error('Could not determine backup entry ID.');
            return;
        }
        var cmd = '<?=$rc_name?> '+command_name+' '+the_uid+' echopid';
        start_backup_command(cmd, initial_message);
    }
    function show_send_backup_error(message) {
        swal({
            title:"_(Can not start backup)_",
            text:'<div class="buddybackup-center">'+escape_html(message).replace(/\n/g, '<br>')+'</div>',
            type:'warning',
            html:true,
            showCancelButton:false,
            confirmButtonText:"_(Ok)_"
        });
    }
    function show_missing_snapshot_actions(form, message) {
        swal({
            title:"_(No snapshots yet)_",
            text:'<div class="buddybackup-center">'+escape_html(message).replace(/\n/g, '<br>')+'</div>',
            type:'warning',
            html:true,
            showCancelButton:true,
            confirmButtonText:"_(Create fresh snapshot and send now)_",
            cancelButtonText:"_(Cancel)_"
        }, function(is_confirm) {
            if (is_confirm) {
                window.setTimeout(function() {
                    start_saved_backup(form, 'create_snapshot_and_send', "\nCreating fresh snapshot and running backup..\n");
                }, 150);
            }
        });
    }
    function request_send_backup_preflight(form) {
        var the_uid = form.find("input[name='#section']").val();
        if (!the_uid) {
            show_send_backup_error('Could not determine backup entry ID.');
            return;
        }
        var cmd = '<?=$rc_name?> preflight_send_backup '+the_uid;
        var dest_type = form.find("select[name='type']").val();

        $.post('/webGui/include/StartCommand.php',{cmd:cmd,start:2})
            .done(function(raw_response) {
                var response = null;

                try {
                    response = JSON.parse($.trim(raw_response));
                } catch (error) {
                    show_send_backup_error('Could not parse backup preflight response.');
                    return;
                }

                if (!response || !response.status) {
                    show_send_backup_error('Backup preflight returned an invalid response.');
                    return;
                }

                if (response.status === 'ok') {
                    start_saved_backup(form, 'send_backup', "\nRunning backup..\n");
                    return;
                }

                if (response.status === 'missing_snapshots') {
                    show_missing_snapshot_actions(form, response.message || 'No snapshots are available yet.');
                    return;
                }

                show_send_backup_error(response.message || 'Could not start backup.');
            })
            .fail(function(xhr, status, error) {
                show_send_backup_error('Failed to run backup preflight: '+error);
            });
    }
    function test_connection(btn) {
        var form = get_backup_form(btn);
        var dest_type = form.find("select[name='type']").val();
        if (dest_type == "remote_generic") {
            var ip = shell_escape_arg(form.find('input[name="destination_host"]').val());
            var destination_dataset = shell_escape_arg(form.find('input[name="destination_dataset"]').val());
            var remote_user = shell_escape_arg(form.find('input[name="destination_user"]').val() || 'buddybackup');
            var remote_port = shell_escape_arg(form.find('input[name="destination_port"]').val() || '22');
            buddybackup_show_popup('<?=$rc_name?> test_connection "'+ip+'" "'+destination_dataset+'" remote_generic "'+remote_user+'" "'+remote_port+'"', '_(Connection test)_', "Testing connection to "+ip+"..")
        } else {
            var ip = shell_escape_arg(form.find('input[name="destination_host"]').val());
            var destination_dataset = shell_escape_arg(form.find('input[name="destination_dataset"]').val());
            buddybackup_show_popup('<?=$rc_name?> test_connection "'+ip+'" "'+destination_dataset+'"', '_(Connection test)_', "Testing connection to buddy at "+ip+"..")
        }
    }
    function send_backup(btn) {
        var form = get_backup_form(btn);
        request_send_backup_preflight(form);
    }
    function create_snapshot_and_send(btn) {
        var form = get_backup_form(btn);
        start_saved_backup(form, 'create_snapshot_and_send', "\nCreating fresh snapshot and running backup..\n");
    }

    function backup_input_changed(ctx, on_change = false) {
        var form = $(ctx).parentsUntil('form').parent();
        var card = form.closest('.buddybackup-entry-card');
        var scope = card.length ? card : form;
        if (on_change) {
            form.find("input[name='#apply']").not('.lock').prop('disabled', false);
            scope.find('input.disable-on-unsaved').not('.lock').prop('disabled', true).addClass("lock").attr('title', '_(Apply changes to enable this)_');
            scope.find('input.disable-on-unsaved-simple').not('.lock').prop('disabled', true).addClass("lock");
        }
        var dest_type = form.find("select[name='type']").val();
        var allow_unencrypted_remote_backups = "<?=$cfg["AllowUnencryptedRemoteBackups"]?>";
        if (dest_type == "remote" || dest_type == "remote_generic") {
            form.find('.buddybackup-type-remote').show();
            form.find('.buddybackup-note-local').hide();
            if (dest_type == "remote_generic") {
                form.find('.buddybackup-type-generic').show();
                form.find('.buddybackup-note-remote').hide();
                form.find('.buddybackup-note-generic').show();
                update_generic_setup_helper(form);
            } else {
                form.find('.buddybackup-type-generic').hide();
                form.find('.buddybackup-note-remote').show();
                form.find('.buddybackup-note-generic').hide();
            }
            form.find('input[name="destination_dataset"]').removeAttr('list');

            var source_dataset = form.find('select[name="source_dataset"]');
            var source_dataset_val = source_dataset.val();
            if (allow_unencrypted_remote_backups == "yes") {
                source_dataset.html($('datalist#local-datasets').html());
            } else {
                source_dataset.html($('datalist#local-encrypted-datasets').html());
            }
            source_dataset.val(source_dataset_val);
        } else if (dest_type == "local") {
            form.find('.buddybackup-type-remote').hide();
            form.find('.buddybackup-type-generic').hide();
            form.find('.buddybackup-note-remote').hide();
            form.find('.buddybackup-note-generic').hide();
            form.find('.buddybackup-note-local').show();
            form.find('input[name="destination_dataset"]').attr('list', 'local-datasets');

            var source_dataset = form.find('select[name="source_dataset"]');
            var source_dataset_val = source_dataset.val();
            source_dataset.html($('datalist#local-datasets').html());
            source_dataset.val(source_dataset_val);
        }
        var is_recursive = form.find("select[name='recursive']").val() == "yes";
        if (is_recursive) {
            form.find('.buddybackup-skip-parent-row').show();
        } else {
            form.find('.buddybackup-skip-parent-row').hide();
        }
    }
    $(function() { 
        $('form.buddybackup-backup-entry')
            .find('select,input[type=text],input[type=number],input[type=password],input[type=checkbox],input[type=radio],input[type=file],textarea')
            .not('.lock').each(function(){backup_input_changed(this); $(this).on('input change', function(){backup_input_changed(this, true)})});
    })
    function add_backup() {
        var template = $("#buddybackup-backup-entry-template");
        var list = $("#buddybackup-backup-list");
        var new_uid = uid();
        var new_entry = $(template.html());
        new_entry.attr("id", "entry-" + new_uid);
        new_entry.addClass("is-expanded");
        new_entry.find(".buddybackup-header-chevron").removeClass("fa-chevron-right").addClass("fa-chevron-down");
        var new_form = new_entry.find("form.buddybackup-backup-entry");
        new_form.attr("method", "POST").attr("action", "/update.php").attr("target", "progressFrame");
        new_form.find("input[name='#section']").val(new_uid);

        new_form.find('select,input[type=text],input[type=number],input[type=password],input[type=checkbox],input[type=radio],input[type=file],textarea')
            .not('.lock').each(function(){backup_input_changed(this); $(this).on('input change', function(){backup_input_changed(this, true)})});

        list.append(new_entry);
    }
    function verify_and_submit_backup(btn) {
        var form = get_backup_form(btn);
        var dest_type = form.find("select[name='type']").val();
        var saved = form.find("input[name='#saved']").val();
        var abort = false;
        if (dest_type == "local" && saved != "true") {
            var destination_dataset = form.find("input[name='destination_dataset']").val();
            var destination_dataset_exists = $("datalist#local-datasets").find("option[value='"+destination_dataset+"']").length > 0;
            if (destination_dataset_exists) {
                swal({title:"_(Dataset exists)_", text:"Local destination dataset already exists. This may cause issues if this is a new backup.", type:'warning', html:true, showCancelButton:true, confirmButtonText:"_(Proceed)_", cancelButtonText:"_(Cancel)_"}, function(p){if (p) {
                    form.submit();
                }});
                return;
            }
        }
        form.submit();
    }
    function remove_backup(btn) {
        swal({title:"_(Proceed)_?", text:"Remove backup", type:'warning', html:true, showCancelButton:true, confirmButtonText:"_(Proceed)_", cancelButtonText:"_(Cancel)_"}, function(p){if (p) {
            var card = $(btn).closest(".buddybackup-entry-card");
            var form = card.find("form.buddybackup-backup-entry");
            var the_uid = form.find("input[name='#section']").val();
            var saved = form.find("input[name='#saved']").val();
            if (saved != "true") {
                card.remove();
                return;
            }
            $.post(api_url,{cmd:'remove_backup_section', 'section':the_uid},function(data) {
                if (data == '') {
                    card.remove();
                } else {
                    alert(data);
                }
            });
        }});
    }
    function restore_from_destination(btn) {
        var form = get_backup_form(btn);
        var the_uid = form.find("input[name='#section']").val();
        var saved = form.find("input[name='#saved']").val();
        if (saved != "true") {
            swal({title:"_(Nope)_", text:"Backup entry not saved. Hit 'apply' before running a restore.", type:'warning', html:true, showCancelButton:false, confirmButtonText:"_(Ok)_"});
            return;
        }

        var csrf_token = $('input[name="csrf_token"]').val();
        openBox('/plugins/<?=$plugin?>/restore_wizard.php?uid='+the_uid+'&csrf_token='+csrf_token, 'Restore snapshot wizard', 500, 600, false);
    }

    if (typeof buddybackup_copy_key === 'undefined') {
        function buddybackup_copy_to_clipboard(text) {
            if (navigator.clipboard && window.isSecureContext) {
                return navigator.clipboard.writeText(text).then(function() {
                    return true;
                }).catch(function() {
                    return buddybackup_fallback_copy(text);
                });
            }
            return Promise.resolve(buddybackup_fallback_copy(text));
        }

        function buddybackup_fallback_copy(text) {
            var successful = false;
            try {
                var ta = document.createElement('textarea');
                ta.value = text;
                ta.setAttribute('readonly', '');
                ta.style.position = 'fixed';
                ta.style.top = '0';
                ta.style.left = '0';
                ta.style.width = '2em';
                ta.style.height = '2em';
                ta.style.padding = '0';
                ta.style.border = 'none';
                ta.style.outline = 'none';
                ta.style.boxShadow = 'none';
                ta.style.background = 'transparent';
                ta.style.opacity = '0.01';
                document.body.appendChild(ta);
                ta.focus();
                ta.select();
                ta.setSelectionRange(0, text.length);
                successful = document.execCommand('copy');
                document.body.removeChild(ta);
            } catch (e) {
                successful = false;
            }
            return successful;
        }

        function buddybackup_copy_key(btn, text) {
            var $btn = $(btn);
            var $input = $btn.siblings('input[type="text"]');
            if (!$input.length) {
                $input = $btn.closest('.buddybackup-field-with-btn').find('input[type="text"]');
            }
            if (!$input.length) {
                $input = $('#buddybackup_public_key');
            }

            if (typeof text === 'undefined' || text === null || text === '') {
                text = $input.val() || '';
            }
            text = String(text).trim();

            var existingTimer = $btn.data('copy-timer');
            if (existingTimer) {
                clearTimeout(existingTimer);
                $btn.removeData('copy-timer');
            }

            var isButtonTag = $btn.is('button');
            var origHtml = $btn.data('orig-html');
            var origVal = $btn.data('orig-val');
            if (!origHtml && isButtonTag) {
                origHtml = $btn.html();
                $btn.data('orig-html', origHtml);
            } else if (!origVal && !isButtonTag) {
                origVal = $btn.val();
                $btn.data('orig-val', origVal);
            }

            var $feedback = $btn.siblings('.buddybackup-copy-feedback');
            if (!$feedback.length) {
                $feedback = $btn.closest('.buddybackup-field-with-btn').find('.buddybackup-copy-feedback');
            }

            if ($input.length) {
                $input.addClass('is-copied');
                try {
                    $input[0].focus();
                    $input[0].select();
                } catch (e) {}
            }

            buddybackup_copy_to_clipboard(text).then(function(success) {
                if (success) {
                    $btn.addClass('is-copied');
                    if (isButtonTag) {
                        $btn.html('<i class="fa fa-check"></i> <span><?=_("Copied!")?></span>');
                    } else {
                        $btn.val("<?=_('Copied!')?>");
                    }
                    if ($feedback.length) {
                        $feedback.removeClass('is-error').html('<i class="fa fa-check-circle"></i> <?=_("Copied to clipboard!")?>').css('display', 'inline-flex');
                    }
                } else {
                    $btn.removeClass('is-copied');
                    if ($feedback.length) {
                        $feedback.addClass('is-error').html('<i class="fa fa-exclamation-triangle"></i> <?=_("Press Ctrl+C to copy")?>').css('display', 'inline-flex');
                    }
                }

                var timer = setTimeout(function() {
                    $btn.removeClass('is-copied');
                    if (isButtonTag) {
                        $btn.html($btn.data('orig-html') || origHtml);
                    } else {
                        $btn.val($btn.data('orig-val') || origVal);
                    }
                    if ($input.length) {
                        $input.removeClass('is-copied');
                    }
                    if ($feedback.length) {
                        $feedback.fadeOut(200, function() {
                            $(this).empty().css('display', 'none');
                        });
                    }
                    $btn.removeData('copy-timer');
                }, 2500);

                $btn.data('copy-timer', timer);
            });
        }
    }
</script>

