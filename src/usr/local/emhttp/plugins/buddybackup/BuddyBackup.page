<script>
    var api_url = "/plugins/<?=$plugin?>/api.php";

    function buddybackup_show_popup(cmd, title, info, button=0, callback=null) {
        // button = 0 : hide CLOSE button (default)
        // button = 1 : show CLOSE button
        swal({title:title,text:"<pre id='swalbody'></pre><hr>",html:true,animation:'none',showConfirmButton:button!=0,confirmButtonText:"<?=_('Close')?>"}, function(){$('.sweet-alert').removeClass('nchan');});
        $('.sweet-alert').addClass('nchan');
        $('button.confirm').text("<?=_('Done')?>").prop('disabled',false).show();
        $('pre#swalbody').append(info+"<br><br>");
        $.post('/webGui/include/StartCommand.php',{cmd:cmd,start:2},function(data) {
            $('pre#swalbody').append(data.replace(/\n/g, "<br>"));
            if (callback) {
                callback(data);
            }
        });
    }
    function uid() {
        return 'xxxxxxxx'.replace(/[xy]/g, function(c) {
            var r = Math.random() * 16 | 0, v = c == 'x' ? r : (r & 0x3 | 0x8);
            return v.toString(16);
        });
    }
    function isNumeric(str) {
        if (typeof str != "string") return false;
        return !isNaN(str) && !isNaN(parseFloat(str));
    }

    // Throw away messages at beginning of page load since they are probably old cached messages
    var allow_nchan = false;
    $(document).ready(function() {
        setTimeout(function() { 
            allow_nchan = true;
        }, 100);
    });

    var restore_in_progress = false;
    var backup_in_progress = false;
    var auto_scroll = true;

    var nchan_buddybackup_restore = new NchanSubscriber('/sub/buddybackup-restore',{subscriber:'websocket'});
    var nchan_buddybackup_backup = new NchanSubscriber('/sub/buddybackup-send',{subscriber:'websocket'});
    nchan_buddybackup_restore.on('message', function(data) {
        if (!allow_nchan) return;

        restore_in_progress = true;
        $('#buddybackup-not-running').hide();
        $('#buddybackup-restore-running').show();

        var output_log = $('.buddybackup-restore-output-log');
        output_log.append(data+'\n');

        if (auto_scroll) {
            var ta = $('.active-textarea');
            ta.animate({scrollTop:ta.prop("scrollHeight") - ta.height()}, 200);
        }
    });
    nchan_buddybackup_backup.on('message', function(data) {
        if (!allow_nchan) return;

        backup_in_progress = true;
        $('#buddybackup-not-running').hide();
        $('#buddybackup-backup-running').show();
        
        var output_log = $('.buddybackup-backup-output-log');
        output_log.append(data+'\n');

        if (auto_scroll) {
            var ta = $('.active-textarea');
            ta.animate({scrollTop:ta.prop("scrollHeight") - ta.height()}, 200);
        }
    });
    nchan_buddybackup_restore.start();
    nchan_buddybackup_backup.start();

    function toggle_autoscroll(cb) {
        auto_scroll = cb.checked;
        $('.buddybackup-toggle-autoscroll').prop('checked', auto_scroll);
    }
    function abort_backups() {
        $.post(api_url, { cmd:"count_running_backups" }, function(count){
            $('.sweet-alert').removeClass('nchan');
            if (count == 0) { 
                swal({title:"_(No backups are running)_", html:true, type:'info', width: 600});
                return;
            }
            swal({title:"_(Abort all running backups?)_", text:count+" running backup"+((count>1)?"s":"")+" will be stopped.", type:'warning', html:true, showCancelButton:true, confirmButtonText:"_(Proceed)_", cancelButtonText:"_(Cancel)_"}, function(p){if (p) {
                $.post(api_url, { cmd:"kill_running_backups" }, function(){
                    $('.buddybackup-backup-output-log').append("\nBackups aborted by user!\n");
                });
            }});
        });
    }
    function abort_restores() {
        $.post(api_url, { cmd:"count_running_restores" }, function(count){
            $('.sweet-alert').removeClass('nchan');
            if (count == 0) {
                swal({title:"_(No restores are running)_", html:true, type:'info', width: 600});
                return;
            }
            swal({title:"_(Abort all running restores?)_", text:count+" running restore"+((count>1)?"s":"")+" will be stopped.", type:'warning', html:true, showCancelButton:true, confirmButtonText:"_(Proceed)_", cancelButtonText:"_(Cancel)_"}, function(p){if (p) {
                $.post(api_url, { cmd:"kill_running_restores" }, function(){
                    $('.buddybackup-restore-output-log').append("\nRestores aborted by user!\n");
                });
            }});
        });
    }

    function show_in_progress_log(title, element_name, log_class, abort_text=null, abort_func=null) {
        swal({title:title,text:"<pre id='swalbody'></pre><hr>",html:true,animation:'none',showConfirmButton:true,confirmButtonText:"<?=_('Close')?>",showCancelButton:(abort_text!=null),cancelButtonText:abort_text},
            function(p){
                $('.sweet-alert').removeClass('nchan');
                if (!p && abort_func) abort_func();
            }
        );
        $('.sweet-alert').addClass("nchan");
        $('pre#swalbody').html($(element_name).html());
        $('pre#swalbody').addClass("buddybackup-center");
        $('pre#swalbody').find("textarea").addClass(log_class);
        $('.buddybackup-toggle-autoscroll').prop('checked', auto_scroll);
    }

    function buddybackup_toggle_card(headerElem) {
        var card = $(headerElem).closest('.buddybackup-entry-card');
        var icon = card.find('.buddybackup-header-chevron');
        var is_expanded = card.toggleClass('is-expanded').hasClass('is-expanded');
        if (icon.length) {
            icon.removeClass('fa-chevron-down fa-chevron-right')
                .addClass(is_expanded ? 'fa-chevron-down' : 'fa-chevron-right');
        }
    }

    function buddybackup_toggle_all(selector, action) {
        var container = (typeof selector === 'string' && !selector.startsWith('#') && !selector.startsWith('.')) ? $('#' + selector) : $(selector);
        var cards = container.find('.buddybackup-entry-card');

        if (typeof action === 'boolean') {
            if (action) {
                cards.addClass('is-expanded').find('.buddybackup-header-chevron')
                    .removeClass('fa-chevron-right').addClass('fa-chevron-down');
                container.data('collapsed', false);
            } else {
                cards.removeClass('is-expanded').find('.buddybackup-header-chevron')
                    .removeClass('fa-chevron-down').addClass('fa-chevron-right');
                container.data('collapsed', true);
            }
            return;
        }

        var btn = action;
        var is_collapsed = container.data('collapsed') === true;
        if (is_collapsed) {
            cards.addClass('is-expanded').find('.buddybackup-header-chevron')
                .removeClass('fa-chevron-right').addClass('fa-chevron-down');
            container.data('collapsed', false);
            if (btn) {
                $(btn).find('span').text("<?=_('Collapse All')?>");
                $(btn).find('i').removeClass('fa-expand').addClass('fa-compress');
            }
        } else {
            cards.removeClass('is-expanded').find('.buddybackup-header-chevron')
                .removeClass('fa-chevron-down').addClass('fa-chevron-right');
            container.data('collapsed', true);
            if (btn) {
                $(btn).find('span').text("<?=_('Expand All')?>");
                $(btn).find('i').removeClass('fa-compress').addClass('fa-expand');
            }
        }
    }

    function buddybackup_copy_to_clipboard(text) {
        if (navigator.clipboard && window.isSecureContext) {
            return navigator.clipboard.writeText(text).then(function() {
                return true;
            }).catch(function() {
                return buddybackup_fallback_copy(text);
            });
        }
        return Promise.resolve(buddybackup_fallback_copy(text));
    }

    function buddybackup_fallback_copy(text) {
        var successful = false;
        try {
            var ta = document.createElement('textarea');
            ta.value = text;
            ta.setAttribute('readonly', '');
            ta.style.position = 'fixed';
            ta.style.top = '0';
            ta.style.left = '0';
            ta.style.width = '2em';
            ta.style.height = '2em';
            ta.style.padding = '0';
            ta.style.border = 'none';
            ta.style.outline = 'none';
            ta.style.boxShadow = 'none';
            ta.style.background = 'transparent';
            ta.style.opacity = '0.01';
            document.body.appendChild(ta);
            ta.focus();
            ta.select();
            ta.setSelectionRange(0, text.length);
            successful = document.execCommand('copy');
            document.body.removeChild(ta);
        } catch (e) {
            successful = false;
        }
        return successful;
    }

    function buddybackup_copy_key(btn, text) {
        var $btn = $(btn);
        var $input = $btn.siblings('input[type="text"]');
        if (!$input.length) {
            $input = $btn.closest('.buddybackup-field-with-btn').find('input[type="text"]');
        }
        if (!$input.length) {
            $input = $('#buddybackup_public_key');
        }

        if (typeof text === 'undefined' || text === null || text === '') {
            text = $input.val() || '';
        }
        text = String(text).trim();

        var existingTimer = $btn.data('copy-timer');
        if (existingTimer) {
            clearTimeout(existingTimer);
            $btn.removeData('copy-timer');
        }

        var isButtonTag = $btn.is('button');
        var origHtml = $btn.data('orig-html');
        var origVal = $btn.data('orig-val');
        if (!origHtml && isButtonTag) {
            origHtml = $btn.html();
            $btn.data('orig-html', origHtml);
        } else if (!origVal && !isButtonTag) {
            origVal = $btn.val();
            $btn.data('orig-val', origVal);
        }

        var $feedback = $btn.siblings('.buddybackup-copy-feedback');
        if (!$feedback.length) {
            $feedback = $btn.closest('.buddybackup-field-with-btn').find('.buddybackup-copy-feedback');
        }

        if ($input.length) {
            $input.addClass('is-copied');
            try {
                $input[0].focus();
                $input[0].select();
            } catch (e) {}
        }

        buddybackup_copy_to_clipboard(text).then(function(success) {
            if (success) {
                $btn.addClass('is-copied');
                if (isButtonTag) {
                    $btn.html('<i class="fa fa-check"></i> <span><?=_("Copied!")?></span>');
                } else {
                    $btn.val("<?=_('Copied!')?>");
                }
                if ($feedback.length) {
                    $feedback.removeClass('is-error').html('<i class="fa fa-check-circle"></i> <?=_("Copied to clipboard!")?>').css('display', 'inline-flex');
                }
            } else {
                $btn.removeClass('is-copied');
                if ($feedback.length) {
                    $feedback.addClass('is-error').html('<i class="fa fa-exclamation-triangle"></i> <?=_("Press Ctrl+C to copy")?>').css('display', 'inline-flex');
                }
            }

            var timer = setTimeout(function() {
                $btn.removeClass('is-copied');
                if (isButtonTag) {
                    $btn.html($btn.data('orig-html') || origHtml);
                } else {
                    $btn.val($btn.data('orig-val') || origVal);
                }
                if ($input.length) {
                    $input.removeClass('is-copied');
                }
                if ($feedback.length) {
                    $feedback.fadeOut(200, function() {
                        $(this).empty().css('display', 'none');
                    });
                }
                $btn.removeData('copy-timer');
            }, 2500);

            $btn.data('copy-timer', timer);
        });
    }

</script>
