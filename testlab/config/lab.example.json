{
  "provider": "windows-local",
  "artifactsRoot": ".testlab/artifacts",
  "logsRoot": ".testlab/logs",
  "ssh": {
    "user": "root",
    "port": 22,
    "identityFile": ".testlab/lab_key"
  },
  "nodes": {
    "sender": {
      "name": "buddybackup-sender",
      "host": "127.0.0.1",
      "port": 2222,
      "unraidVersion": "7.2.6",
      "pluginVersion": "2026.05.02"
    },
    "receiver": {
      "name": "buddybackup-receiver",
      "host": "127.0.0.1",
      "port": 2223,
      "unraidVersion": "7.2.6",
      "pluginVersion": "2026.05.02"
    }
  },
  "plugin": {
    "installMethod": "url",
    "plgUrlTemplate": "https://github.com/Piratkopia13/unraid-buddybackup/releases/download/{version}/buddybackup.plg",
    "buildCacheRoot": ".testlab/build-cache"
  },
  "releaseGate": {
    "historyRoot": "%LOCALAPPDATA%/BuddyBackup/TestlabHistory",
    "defaultMatrixProfile": "release-default",
    "currentCandidatePlugin": "workspace-build",
    "previousReleaseVersion": "2026.05.02",
    "previousCertifiedUnraidVersion": "7.2.6",
    "latestSupportedUnraidVersion": "7.2.6",
    "versionPolicy": {
      "mode": "require"
    }
  },
  "timeouts": {
    "sshReadySeconds": 300,
    "rebootSettleSeconds": 30
  },
  "wslQemu": {
    "distro": "Ubuntu",
    "cacheRoot": ".testlab/cache",
    "imageSizeMB": 1024,
    "dataDiskSizeGB": 3,
    "bootWaitSeconds": 120,
    "unraidDownloadUrlTemplate": "https://releases.unraid.net/stable/unraid-{version}.zip"
  },
  "setup": {
    "applyBaseConfigAfterSsh": true,
    "verifyBaseConfigInMatrix": true,
    "manualAccess": {
      "rootPassword": "buddybackup-testlab"
    },
    "buddybackup": {
      "pluginVersion": "2026.05.02",
      "pluginUrlTemplate": "https://github.com/Piratkopia13/unraid-buddybackup/releases/download/{version}/buddybackup.plg",
      "failOnWarningOrError": true
    },
    "zfs": {
      "poolName": "bbpool",
      "datasetRoot": "buddybackup",
      "unencryptedDatasetName": "plain",
      "encryptedDatasetName": "secure",
      "encryptedPassphrase": "buddybackup-testlab-passphrase"
    }
  }
}
