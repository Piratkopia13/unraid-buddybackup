{
  "provider": "windows-local",
  "artifactsRoot": ".testlab/artifacts",
  "logsRoot": ".testlab/logs",
  "ssh": {
    "user": "root",
    "port": 22,
    "identityFile": ".testlab/lab_key"
  },
  "nodes": {
    "sender": {
      "name": "buddybackup-sender",
      "host": "127.0.0.1",
      "port": 2222,
      "unraidVersion": "7.2.6"
    },
    "receiver": {
      "name": "buddybackup-receiver",
      "host": "127.0.0.1",
      "port": 2223,
      "unraidVersion": "7.2.6"
    }
  },
  "plugin": {
    "installMethod": "url",
    "plgUrlTemplate": "https://github.com/Piratkopia13/unraid-buddybackup/releases/download/{version}/buddybackup.plg"
  },
  "timeouts": {
    "sshReadySeconds": 300,
    "rebootSettleSeconds": 30
  },
  "wslQemu": {
    "distro": "Ubuntu",
    "cacheRoot": ".testlab/cache",
    "imageSizeMB": 1024,
    "bootWaitSeconds": 120,
    "unraidDownloadUrlTemplate": "https://releases.unraid.net/stable/unraid-{version}.zip"
  }
}
